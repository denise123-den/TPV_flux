<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.tpv_flux.controller.layout.MainLayoutController"
            prefWidth="1280.0" prefHeight="800.0"
            stylesheets="@../../css/app.css">

    <!-- =================================================================== -->
    <!-- SIDEBAR IZQUIERDO                                                   -->
    <!-- =================================================================== -->
    <left>
        <VBox styleClass="sidebar">
            <!-- Logo / Marca -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="brand-container">
                <StackPane styleClass="brand-badge">
                    <Label text="T" styleClass="brand-badge-text"/>
                </StackPane>
                <Label text="TPV Core" styleClass="brand-title"/>
            </HBox>

            <!-- Menú de navegación -->
            <VBox styleClass="nav-menu">
                <Button fx:id="btnVentas" maxWidth="Infinity" graphicTextGap="12.0"
                        text="Ventas" onAction="#onShowVentas"
                        styleClass="nav-button, nav-button-active">
                    <graphic>
                        <FontIcon iconLiteral="fth-shopping-cart"/>
                    </graphic>
                </Button>

                <Button fx:id="btnProductos" maxWidth="Infinity" graphicTextGap="12.0"
                        text="Productos" onAction="#onShowProductos"
                        styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-shopping-bag"/>
                    </graphic>
                </Button>

                <Button fx:id="btnCategorias" maxWidth="Infinity" graphicTextGap="12.0"
                        text="Categorías" onAction="#onShowPlaceholder"
                        styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-grid"/>
                    </graphic>
                </Button>

                <Button fx:id="btnInventario" maxWidth="Infinity" graphicTextGap="12.0"
                        text="Inventario" onAction="#onShowPlaceholder"
                        styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-archive"/>
                    </graphic>
                </Button>

                <Button fx:id="btnClientes" maxWidth="Infinity" graphicTextGap="12.0"
                        text="Clientes" onAction="#onShowPlaceholder"
                        styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-users"/>
                    </graphic>
                </Button>

                <Button fx:id="btnCaja" maxWidth="Infinity" graphicTextGap="12.0"
                        text="Caja" onAction="#onShowPlaceholder"
                        styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-credit-card"/>
                    </graphic>
                </Button>

                <Button fx:id="btnReportes" maxWidth="Infinity" graphicTextGap="12.0"
                        text="Reportes" onAction="#onShowPlaceholder"
                        styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-bar-chart-2"/>
                    </graphic>
                </Button>

                <Button fx:id="btnNotificaciones" maxWidth="Infinity"
                        onAction="#onShowPlaceholder"
                        styleClass="nav-button">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0" prefWidth="188.0">
                            <FontIcon iconLiteral="fth-bell"/>
                            <Label text="Notificaciones" styleClass="nav-inline-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="4" styleClass="notification-badge"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnConfiguracion" maxWidth="Infinity" graphicTextGap="12.0"
                        text="Configuración" onAction="#onShowPlaceholder"
                        styleClass="nav-button">
                    <graphic>
                        <FontIcon iconLiteral="fth-settings"/>
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Footer de Usuario Activo -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="sidebar-footer">
                <StackPane styleClass="user-avatar">
                    <Label text="AM" styleClass="user-avatar-text"/>
                </StackPane>
                <VBox spacing="1.0">
                    <Label text="Ana Martínez" styleClass="user-name"/>
                    <Label text="Cajera · Turno AM" styleClass="user-role"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <!-- =================================================================== -->
    <!-- CONTENEDOR CENTRAL DINÁMICO                                         -->
    <!-- =================================================================== -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

</BorderPane>
