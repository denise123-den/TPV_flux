<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.tpv_flux.controller.auth.LoginController"
           prefWidth="1280.0" prefHeight="800.0"
           styleClass="login-background"
           stylesheets="@../../css/app.css">

    <!-- Círculos decorativos de las esquinas-->
    <Circle radius="220.0" styleClass="login-bg-circle" mouseTransparent="true"
            StackPane.alignment="TOP_RIGHT" translateX="70.0" translateY="-70.0"/>
    <Circle radius="180.0" styleClass="login-bg-circle" mouseTransparent="true"
            StackPane.alignment="BOTTOM_LEFT" translateX="-60.0" translateY="60.0"/>

    <!-- Tarjeta central de Inicio de Sesión -->
    <VBox alignment="TOP_CENTER" spacing="18.0"
          maxWidth="395.0" prefWidth="395.0" maxHeight="485.0"
          styleClass="login-card">

        <!-- Logo y Título -->
        <VBox alignment="CENTER" spacing="4.0">
            <StackPane styleClass="login-brand-badge">
                <VBox.margin>
                    <Insets bottom="6.0"/>
                </VBox.margin>
                <Label text="T" styleClass="login-brand-badge-text"/>
            </StackPane>
            <Label text="TPV Core" styleClass="login-title"/>
            <Label text="Accesorios de cómputo y celulares" styleClass="login-subtitle"/>
        </VBox>

        <!-- Campos de formulario -->
        <VBox spacing="12.0">
            <VBox.margin>
                <Insets top="4.0"/>
            </VBox.margin>

            <VBox spacing="5.0">
                <Label text="Usuario" styleClass="login-field-label"/>
                <TextField fx:id="txtUsuario" text="ana.martinez"
                           promptText="ana.martinez" styleClass="login-input"/>
            </VBox>

            <VBox spacing="5.0">
                <Label text="Contraseña" styleClass="login-field-label"/>
                <PasswordField fx:id="txtPassword" text="123456"
                               promptText="••••••••" styleClass="login-input"/>
            </VBox>

            <VBox spacing="5.0">
                <Label text="Terminal / Sucursal" styleClass="login-field-label"/>
                <ComboBox fx:id="cmbTerminal" maxWidth="Infinity" styleClass="filter-combo"/>
            </VBox>
        </VBox>

        <!-- Mensaje de error si falla la autenticación -->
        <Label fx:id="lblError" text="" styleClass="login-error-label"
               visible="false" managed="false" wrapText="true"/>

        <!-- Botón Iniciar sesión -->
        <Button fx:id="btnIniciarSesion" text="Iniciar sesión"
                maxWidth="Infinity" defaultButton="true"
                onAction="#onIniciarSesion" styleClass="primary-action-btn"/>

        <!-- Estado de conexión inferior -->
        <Label fx:id="lblDbStatus" text="v1.0 · Conectado a PostgreSQL local"
               styleClass="login-status-footer">
            <VBox.margin>
                <Insets top="2.0"/>
            </VBox.margin>
        </Label>
    </VBox>

</StackPane>
